{
  "name": "terratag-action",
  "version": "1.0.0",
  "description": "Run Terratag CLI for GitHub Actions",
  "license": "MIT",
  "publisher": "env0",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "build": "tsc --noEmit && esbuild index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js",
    "test": "vitest run",
    "style": "npx prettier --write *.ts lib/*.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@actions/core": "3.0.0",
    "@actions/tool-cache": "3.0.1",
    "axios": "1.21.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "typescript": "7.0.0",
    "vitest": "5.1.0"
  }
}
